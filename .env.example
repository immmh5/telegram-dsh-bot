# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# DeepSeek API Key (for direct API fallback when DSH is not available)
DEEP_SEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Model to use (default: deepseek-chat)
DSH_MODEL=deepseek-chat

# DSH Web URL (optional, for advanced configurations)
# DSH_BASE_URL=http://localhost:3080

# Directory for session storage (defaults to ./sessions)
# SESSIONS_DIR=/app/sessions

# Port for the bot (defaults to 3000)
# PORT=3000